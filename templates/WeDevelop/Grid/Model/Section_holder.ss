<section<% if $HolderClasses %> class="$HolderClasses.ATT"<% end_if %> data-element="$SimpleClassName.LowerCase" data-grid-element-id="$ID" data-grid-element-title="$Title.ATT" id="$Anchor">
    <div class="<% if $ContainerClasses %>$ContainerClasses<% end_if %>">
        $Element
    </div>
</section>
